.env.example

# Discord bot token (bot user token)
DISCORD_TOKEN=
# Discord application client ID
DISCORD_CLIENT_ID=
# Optional: a guild ID to register commands to during development
DISCORD_GUILD_ID=
# Optional: restrict bot commands to this channel ID
AI_CHANNEL_ID=

# OpenAI API key
OPENAI_API_KEY=
# OpenAI model to use (e.g. gpt-4o-mini, gpt-4o, gpt-4o-reason)
OPENAI_MODEL=
